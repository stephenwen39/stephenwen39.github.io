---
import CopyEmail from './CopyEmail.astro';
import { profile } from '../data/content';
interface Props {
  title?: string;
  text?: string;
  label?: string;
  prompts?: { label: string; text: string }[];
}
const {
  title = '從一個好問題，開始一場對話。',
  text = '資料工程、職涯、自我成長或教育。帶著你的好奇，我們聊聊。',
  label = '找我 Coffee Chat',
  prompts = [],
} = Astro.props;
---

<section class="coffee-section" id="coffee-chat" aria-labelledby="coffee-title">
  <div class="container coffee-inner">
    <div>
      <p class="eyebrow">LET’S CONNECT</p>
      <h2 id="coffee-title">{title}</h2>
      <p>{text}</p>
      {prompts.length > 0 && (
        <details class="conversation-guide">
          <summary>不知道怎麼開頭？這裡有幾個起點。</summary>
          <dl>
            {prompts.map((prompt) => (
              <div>
                <dt>{prompt.label}</dt>
                <dd>{prompt.text}</dd>
              </div>
            ))}
          </dl>
        </details>
      )}
    </div>
    <div class="coffee-actions">
      <CopyEmail label={label} variant="button-lime" />
      <span class="email-address">{profile.email}</span>
      <small>
        複製後，貼到你常用的信箱寄信給我。
        <br />
        不會自動寄信，也不會直接預約。
      </small>
    </div>
  </div>
</section>

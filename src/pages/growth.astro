---
import Base from '../layouts/Base.astro';
import CoffeeChat from '../components/CoffeeChat.astro';
import RelatedPages from '../components/RelatedPages.astro';
import { profile, posts } from '../data/content';
import { readingPaths, conversationPrompts } from '../data/audiences';
---

<Base
  title="自媒體與自我成長 — Stephen Wen"
  description="在 Threads 和 Stephen Wen 一起思考自我成長、職涯發展與科技。從真實的工程、教育與生活經驗出發，持續探索，公開學習。"
  theme="growth"
>
  <section class="growth-hero container">
    <a href="/" class="back-link">
      首頁 / 成長內容
    </a>
    <div class="growth-heading">
      <div>
        <p class="eyebrow">03 / THINKING OUT LOUD</p>
        <h1>
          把思考寫下來，
          <br />
          讓成長有跡可循。
        </h1>
        <p class="detail-lead">
          如果你是從 Threads 來的，很高興在這裡遇見你。
          <br />
          這裡有文章背後的我，也有一些可以一起慢慢想的問題。
        </p>
        <div class="hero-buttons">
          <a class="button" href="#start-reading">
            找一篇適合現在的你
          </a>
          <a
            class="button button-outline"
            href={profile.socials[0].url}
            target="_blank"
            rel="noopener noreferrer"
          >
            回 Threads 和我交流<span class="sr-only">（另開新分頁）</span>
          </a>
        </div>
      </div>
      <aside class="growth-note">
        <span class="eyebrow">A NOTE TO MYSELF</span>
        <blockquote>
          當你不再想著成為別人，
          <br />
          而是成為自己的時候，
          <br />
          你就會得到真正的自由。
        </blockquote>
        <span class="note-signature">Stephen</span>
        <a
          href="https://www.threads.com/@iam_wei_stephen/post/DdvdwcRn5j5"
          target="_blank"
          rel="noopener noreferrer"
        >
          Threads · 2026.09.26<span class="sr-only">（另開新分頁）</span>
        </a>
      </aside>
    </div>
    <div class="growth-proof">
      <span class="threads-handle">@iam_wei_stephen</span>
      <span>從資料工程與教育現場，延伸到生活裡的問題。</span>
      <span>持續探索 · 公開學習</span>
    </div>
  </section>
  <section
    class="topics-section"
    id="start-reading"
    aria-labelledby="reading-title"
  >
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">不用從最新的一篇開始</p>
          <h2 id="reading-title">你最近，正想著哪一個問題？</h2>
        </div>
      </div>
      <nav class="reading-paths" aria-label="依你正在思考的問題選文">
        {readingPaths.map((path, i) => (
          <a href={path.href}>
            <span>0{i + 1}</span>
            <h3>{path.question}</h3>
            <p>{path.note}</p>
          </a>
        ))}
      </nav>
    </div>
  </section>
  <section class="container section-space" aria-labelledby="posts-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">START READING HERE</p>
        <h2 id="posts-heading">從這幾篇，開始一段對話。</h2>
      </div>
      <span class="section-aside">我的 Threads 精選</span>
    </div>
    <div class="post-list">
      {posts.map((post, i) => (
        <a
          href={post.url}
          class="post-card"
          id={`post-${post.id}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="post-number">0{i + 1}</span>
          <div>
            <div class="post-meta">
              <span>{post.theme}</span>
              <time datetime={post.date}>{post.date.replaceAll('-', '.')}</time>
            </div>
            <h3>{post.title}</h3>
            <p>{post.summary}</p>
            <p class="post-takeaway">
              <strong>留一個問題給自己</strong>
              {post.takeaway}
            </p>
            <span class="post-source">
              到 Threads 讀原文<span class="sr-only">（另開新分頁）</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
  <section class="growth-about container">
    <p class="eyebrow">BEHIND THE WORDS</p>
    <div>
      <h2>
        寫下來的，
        <br />
        也是我正在練習的。
      </h2>
      <p>
        白天，我在資料系統裡釐清問題；工作之外，我在課輔現場學習陪伴。這些看似不同的經驗，讓我一次次回到「人怎麼學習、怎麼選擇、怎麼改變」的問題。
      </p>
      <p>
        這裡記錄的是個人經驗與思考，不是適用每個人的標準答案。你不必先變得很厲害，才有值得分享的故事；也歡迎帶著不同的觀點來交流。
      </p>
      <div class="experience-bridges">
        <a href="/volunteer/">
          <strong>關於陪伴，不只寫在文章裡。</strong>
          <span>看看我從 2025 年開始的課輔志工經驗。</span>
        </a>
        <a href="/work/#experience">
          <strong>關於探索，也走過自己的轉折。</strong>
          <span>從均一的資料分析實習，到企業資料工程。</span>
        </a>
      </div>
      <div class="writing-links">
        <a
          href={profile.socials[0].url}
          target="_blank"
          rel="noopener noreferrer"
        >
          Threads
          <span>
            日常思考與對話<span class="sr-only">（另開新分頁）</span>
          </span>
        </a>
        <a
          href={profile.socials[2].url}
          target="_blank"
          rel="noopener noreferrer"
        >
          Substack
          <span>
            資料敘事與長篇分享<span class="sr-only">（另開新分頁）</span>
          </span>
        </a>
      </div>
    </div>
  </section>
  <RelatedPages current="/growth/" />
  <CoffeeChat
    title="某個問題，也讓你想了很久嗎？"
    text="想短短交流，歡迎先在 Threads 留言；如果想聊聊自己的故事，也可以寄信給我。不需要先有一個厲害的題目。"
    prompts={conversationPrompts.growth}
  />
</Base>

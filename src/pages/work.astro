---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CopyEmail from '../components/CopyEmail.astro';
import CoffeeChat from '../components/CoffeeChat.astro';
import talk from '../assets/dbt-talk.jpeg';
import discussion from '../assets/dbt-discussion.jpeg';
import { profile } from '../data/content';
const linkedin = profile.socials.find(
  (social) => social.label === 'LinkedIn',
)!.url;
---

<Base
  title="資料工程 — 展維 Stephen Wen"
  description="現任台積電資深資料工程師。從商業需求出發，專注資料平台遷移、從零建構與效能優化；以 dbt、Databricks 與 BigQuery 的實作成果說話。"
  theme="work"
>
  <section class="container feature-hero" id="profile">
    <figure class="feature-photo" id="speaking">
      <Image
        src={talk}
        alt="展維在 Taipei dbt meetup 分享企業資料平台架構與遷移成果"
        widths={[480, 800, 1200, 1600]}
        sizes="(max-width: 800px) 100vw, 50vw"
        format="webp"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>
        在 Taipei dbt meetup 講述企業資料平台遷移的成功案例
      </figcaption>
    </figure>
    <div class="feature-copy">
      <p class="eyebrow">資料工程</p>
      <h1>
        從商業問題出發，
        <br />
        把技術解法做到位。
      </h1>
      <p class="role-line">現任台積電資深資料工程師</p>
      <p class="feature-description">
        我擅長先看懂商業需求，再端出技術解決方案。從平台遷移、從零建構到持續優化，讓資料真正支持團隊的工作。
      </p>
      <div class="action-row">
        <CopyEmail label="寄信給我聊聊" />
        <a
          class="plain-link"
          href={linkedin}
          target="_blank"
          rel="noopener noreferrer"
        >
          查看 LinkedIn<span class="sr-only">（另開新分頁）</span>
        </a>
      </div>
      <p class="action-hint">點擊按鈕複製電子信箱。</p>
    </div>
  </section>

  <section
    class="capability-section"
    id="capabilities"
    aria-labelledby="capability-title"
  >
    <div class="container">
      <div class="section-intro">
        <p class="eyebrow">從建置到演進，都有實戰經驗</p>
        <h2 id="capability-title">
          把資料工程做好，
          <br />
          從這三件事開始。
        </h2>
      </div>
      <div class="expertise-grid">
        <article id="case-delivery">
          <span class="expertise-number">01</span>
          <h3>遷移既有平台</h3>
          <p>
            在大聯大導入 dbt、重建 Databricks
            管線，讓架構轉換也成為團隊交付流程的升級。
          </p>
          <div class="expertise-proof">
            <strong>
              4 小時 <span>→</span> 10 分鐘
            </strong>
            <span>資料部署時間</span>
          </div>
          <p class="tool-note">dbt · Databricks</p>
        </article>
        <article id="case-build">
          <span class="expertise-number">02</span>
          <h3>從零建構</h3>
          <p>
            把需求整理成可重用的資料流程。建立 GA4 與 BigQuery
            處理框架，讓成果能在不同網站持續使用。
          </p>
          <div class="expertise-proof">
            <strong>3 個網站</strong>
            <span>共用同一套資料處理框架</span>
          </div>
          <p class="tool-note">GA4 · BigQuery · SQL</p>
        </article>
        <article id="case-cost">
          <span class="expertise-number">03</span>
          <h3>優化效能與成本</h3>
          <p>
            找出真正的瓶頸，同時改善成本與資料時效。讓 GA4 資料延遲從 24
            小時降至 1 小時內。
          </p>
          <div class="expertise-proof">
            <strong>
              80<span>%</span>
            </strong>
            <span>BigQuery 成本降低</span>
          </div>
          <p class="tool-note">BigQuery · Spark · Dataform</p>
        </article>
      </div>
      <div class="compact-results" id="impact-title">
        <p>
          <strong>98%</strong>
          <span>重構商業邏輯後，處理時間降低</span>
        </p>
        <p id="case-pipelines">
          <strong>400 → 5</strong>
          <span>SQL 任務整併為事件驅動管線</span>
        </p>
        <p>
          <strong>90%</strong>
          <span>管線管理時間降低</span>
        </p>
      </div>
      <p class="source-note">以上為大聯大任職期間的專案成果。</p>
    </div>
  </section>

  <section class="container work-perspective section-pad">
    <div>
      <p class="eyebrow">技術之外，是理解與溝通</p>
      <h2>
        知道為什麼做，
        <br />
        才能把系統做好。
      </h2>
      <p>
        我在意的不只是一條管線能不能執行，而是它解決了誰的問題、團隊能否接手，以及改善是否真的帶來效益。
      </p>
      <figure class="discussion-photo">
        <Image
          src={discussion}
          alt="展維在 Taipei dbt meetup 與參與者面對面交流資料工程經驗"
          widths={[480, 800, 1100]}
          sizes="(max-width: 800px) 90vw, 45vw"
          format="webp"
          loading="lazy"
        />
        <figcaption>把實作經驗帶進社群，也在交流中讓思考更完整。</figcaption>
      </figure>
    </div>
    <div class="career-summary" id="experience">
      <h3>累積經驗的地方</h3>
      <dl>
        <div>
          <dt>
            <span>2026.05 — 至今</span>台積電
          </dt>
          <dd>資深資料工程師</dd>
        </div>
        <div>
          <dt>
            <span>2023.02 — 2026.03</span>WPG Holdings 大聯大
          </dt>
          <dd>
            資料工程師
            <br />
            <small>平台遷移、流程重構與雲端成本優化。</small>
          </dd>
        </div>
        <div>
          <dt>
            <span>2022.02 — 2022.09</span>均一平台教育基金會
          </dt>
          <dd>
            實習資料分析師
            <br />
            <small>優化 20 條 SQL 管線，並從零設計資料敘事與視覺化課程。</small>
          </dd>
        </div>
      </dl>
      <div class="qualification">
        <p>國立成功大學 · 資訊管理碩士</p>
        <p>Google Cloud 專業資料工程師認證</p>
        <span>2026.01 核發 · 2028.01 到期</span>
      </div>
    </div>
  </section>
  <CoffeeChat
    title="你的資料平台，現在卡在哪裡？"
    text="平台遷移、建置規劃，或成本與效能瓶頸。歡迎找我交換想法，也歡迎聊聊職務合作。"
  />
</Base>

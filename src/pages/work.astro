---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CopyEmail from '../components/CopyEmail.astro';
import CoffeeChat from '../components/CoffeeChat.astro';
import talk from '../assets/dbt-talk.jpeg';
import discussion from '../assets/dbt-discussion.jpeg';
import { profile } from '../data/content';
const linkedin = profile.socials.find(
  (social) => social.label === 'LinkedIn',
)!.url;
---

<Base
  title="資料工程 — 展維 Stephen Wen"
  description="現任台積電資深資料工程師。具備 Oracle 遷移至 Databricks、從零建構 Databricks 與 GCP 資料平台，以及 GCP／Databricks 計算成本與效能優化的實務經驗。"
  theme="work"
>
  <section class="container feature-hero" id="profile">
    <figure class="feature-photo" id="speaking">
      <Image
        src={talk}
        alt="展維在 Taipei dbt meetup 分享企業資料平台架構與遷移成果"
        widths={[480, 800, 1200, 1600]}
        sizes="(max-width: 800px) 100vw, 50vw"
        format="webp"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>
        在 Taipei dbt meetup 講述企業資料平台遷移的成功案例
      </figcaption>
    </figure>
    <div class="feature-copy">
      <p class="eyebrow">資料工程</p>
      <h1>
        從商業問題出發，
        <br />
        把技術解法做到位。
      </h1>
      <p class="role-line">現任台積電資深資料工程師</p>
      <p class="feature-description">
        我擅長先看懂商業需求，再端出技術解決方案。從平台遷移、從零建構到持續優化，讓資料真正支持團隊的工作。
      </p>
      <div class="action-row">
        <CopyEmail label="寄信給我聊聊" />
        <a
          class="plain-link"
          href={linkedin}
          target="_blank"
          rel="noopener noreferrer"
        >
          查看 LinkedIn<span class="sr-only">（另開新分頁）</span>
        </a>
      </div>
      <p class="action-hint">點擊按鈕複製電子信箱。</p>
    </div>
  </section>

  <section
    class="capability-section"
    id="capabilities"
    aria-labelledby="capability-title"
  >
    <div class="container">
      <div class="section-intro">
        <p class="eyebrow">資料平台實戰經驗</p>
        <h2 id="capability-title">從平台遷移，到持續優化。</h2>
      </div>
      <div class="expertise-grid">
        <article id="case-delivery">
          <h3>Oracle 遷移至 Databricks</h3>
          <p>
            曾將老舊的 Oracle 計算平台遷移至
            Databricks，具備跨平台遷移與資料處理流程重整的實務經驗。
          </p>
        </article>
        <article id="case-build">
          <h3>從零建構資料平台</h3>
          <p>
            從零建構 Databricks &amp; GCP
            資料平台，融合多項技術，將商業需求落實為資料處理流程與可持續維護的平台架構。
          </p>
        </article>
        <article id="case-cost">
          <h3>優化計算成本與效能</h3>
          <p>
            具備 GCP 與 Databricks
            平台的成本及效能優化經驗，兼顧運算效率、使用成本與實際業務需求。
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="container work-perspective section-pad">
    <div>
      <p class="eyebrow">技術之外，是理解與溝通</p>
      <h2>
        知道為什麼做，
        <br />
        才能把系統做好。
      </h2>
      <p>
        我在意的不只是一條管線能不能執行，而是它解決了誰的問題、團隊能否接手，以及改善是否真的帶來效益。
      </p>
      <figure class="discussion-photo">
        <Image
          src={discussion}
          alt="展維在 Taipei dbt meetup 與參與者面對面交流資料工程經驗"
          widths={[480, 800, 1100]}
          sizes="(max-width: 800px) 90vw, 45vw"
          format="webp"
          loading="lazy"
        />
        <figcaption>把實作經驗帶進社群，也在交流中讓思考更完整。</figcaption>
      </figure>
    </div>
    <div class="career-summary" id="experience">
      <h3>累積經驗的地方</h3>
      <dl>
        <div>
          <dt>
            <span>2026.05 — 至今</span>台積電
          </dt>
          <dd>資深資料工程師</dd>
        </div>
        <div>
          <dt>
            <span>2023.02 — 2026.03</span>WPG Holdings 大聯大
          </dt>
          <dd>
            資料工程師
            <br />
            <small>平台遷移、流程重構與雲端成本優化。</small>
          </dd>
        </div>
        <div>
          <dt>
            <span>2022.02 — 2022.09</span>均一平台教育基金會
          </dt>
          <dd>
            實習資料分析師
            <br />
            <small>優化 20 條 SQL 管線，並從零設計資料敘事與視覺化課程。</small>
          </dd>
        </div>
      </dl>
      <div class="qualification">
        <p>國立成功大學 · 資訊管理碩士</p>
        <p>Google Cloud 專業資料工程師認證</p>
        <span>2026.01 核發 · 2028.01 到期</span>
      </div>
    </div>
  </section>
  <CoffeeChat
    title="你的資料平台，現在卡在哪裡？"
    text="平台遷移、建置規劃，或成本與效能瓶頸。歡迎找我交換想法，也歡迎聊聊職務合作。"
  />
</Base>

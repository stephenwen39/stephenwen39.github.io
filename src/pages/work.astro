---
import Base from '../layouts/Base.astro';
import CoffeeChat from '../components/CoffeeChat.astro';
import CopyEmail from '../components/CopyEmail.astro';
import RelatedPages from '../components/RelatedPages.astro';
import StartingOut from '../components/StartingOut.astro';
import Speaking from '../components/Speaking.astro';
import { skillEvidence, conversationPrompts } from '../data/audiences';
import {
  profile,
  engineeringCases as cases,
  experiences,
} from '../data/content';
---

<Base
  title="資料工程與職涯 — Stephen Wen"
  description="Stephen Wen，TSMC Senior Data Engineer。探索 dbt、Databricks、GCP 與 Spark 的量化成果、工作經歷及 Taipei dbt Meetup 分享。"
  theme="work"
>
  <section class="work-hero" id="profile">
    <div class="container">
      <a href="/" class="back-link">
        首頁 / 資料工程
      </a>
      <div class="work-hero-grid">
        <div>
          <p class="eyebrow">01 / DATA ENGINEERING</p>
          <h1>
            讓資料跑得更好，
            <br />
            也讓團隊走得更遠。
          </h1>
          <p class="detail-lead">
            我是 Stephen，現任 TSMC Senior Data Engineer。
            <br />從 0 到 1
            建立資料系統，也把既有架構做得更快、更省、更容易交付。
          </p>
          <div class="hero-buttons">
            <CopyEmail label="聯絡我聊職務或技術" variant="button-lime" />
            <a
              class="button button-on-dark"
              href={profile.socials[1].url}
              target="_blank"
              rel="noopener noreferrer"
            >
              查看 LinkedIn<span class="sr-only">（另開新分頁）</span>
            </a>
          </div>
        </div>
        <aside class="professional-snapshot" aria-label="專業速覽">
          <p class="eyebrow">30 秒認識我的專業背景</p>
          <dl>
            <div>
              <dt>現在</dt>
              <dd>
                TSMC
                <br />
                <span>Senior Data Engineer · 2026.05 起</span>
              </dd>
            </div>
            <div>
              <dt>過去</dt>
              <dd>
                WPG Holdings 大聯大
                <br />
                <span>Data Engineer · 2023.02–2026.03</span>
              </dd>
            </div>
            <div>
              <dt>認證</dt>
              <dd>
                Google Cloud
                <br />
                <span>Professional Data Engineer</span>
              </dd>
            </div>
          </dl>
          <p class="snapshot-note">
            公開成果主要來自大聯大任職期間；不揭露現職內部系統資訊。
          </p>
        </aside>
      </div>
    </div>
  </section>
  <nav class="page-sections container" aria-label="資料工程頁快速導覽">
    <a href="#capabilities">專長與適配</a>
    <a href="#impact-title">實作成果</a>
    <a href="#experience">職涯經歷</a>
    <a href="#speaking">dbt 演講</a>
    <a href="#starting-out">轉職入門</a>
    <a href="#coffee-chat">聯絡與交流</a>
  </nav>
  <section
    class="container capability-section"
    id="capabilities"
    aria-labelledby="capability-title"
  >
    <h2 id="capability-title">如果你的團隊正在解決這些問題。</h2>
    <div class="capability-grid">
      {skillEvidence.map((skill) => (
        <a href={skill.href}>
          <h3>{skill.title}</h3>
          <p class="capability-tools">{skill.tools}</p>
          <p>{skill.proof}</p>
          <span>查看對應實作</span>
        </a>
      ))}
    </div>
  </section>
  <section class="container section-space" aria-labelledby="impact-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">PROVEN IN PRACTICE</p>
        <h2 id="impact-title">讓成果，替實作說話。</h2>
      </div>
      <p class="section-aside">
        以下成果來自大聯大任職期間，
        <br />
        依公開 LinkedIn 資料整理。
      </p>
    </div>
    <div class="case-grid">
      {cases.map((c) => (
        <article class="case-card" id={`case-${c.id}`}>
          <div class="case-number">{c.n}</div>
          <p class="case-metric">
            {c.value}
            <span>{c.unit}</span>
          </p>
          <p class="case-label">{c.label}</p>
          <span class="case-from">{c.from}</span>
          <h3>{c.title}</h3>
          <p class="case-description">{c.text}</p>
          <div class="tech-tags">
            {c.tags.map((t) => (
              <span>{t}</span>
            ))}
          </div>
          <details>
            <summary>
              看看做法與脈絡<span aria-hidden="true">＋</span>
            </summary>
            <dl class="case-context">
              <div>
                <dt>當時的問題</dt>
                <dd>{c.problem}</dd>
              </div>
              <div>
                <dt>我的投入</dt>
                <dd>{c.contribution}</dd>
              </div>
              <div>
                <dt>成果口徑</dt>
                <dd>{c.detail}</dd>
              </div>
            </dl>
            <div class="case-discussion">
              <strong>可以一起討論</strong>
              <p>{c.discussion}</p>
            </div>
          </details>
          {c.id === 'delivery' && (
            <a class="text-link" href="#speaking">
              看 dbt Meetup 演講現場
            </a>
          )}
        </article>
      ))}
    </div>
    <p class="evidence-boundary">
      案例依公開 LinkedIn
      經歷整理，未提供內部架構、原始碼或測試基準；交流問題僅供討論，不代表未公開的實作細節。
    </p>
  </section>
  <section class="experience-section" id="experience">
    <div class="container split-section">
      <div class="section-intro">
        <p class="eyebrow">THE JOURNEY</p>
        <h2>
          一路累積的，
          <br />
          不只是工具。
        </h2>
        <p>
          從教育科技到企業資料平台，持續練習把技術限制、商業需求與人的工作方式放在一起思考。
        </p>
      </div>
      <div class="timeline">
        {experiences.map((experience) => (
          <article>
            <div class="timeline-meta">
              <span>{experience.period}</span>
              {experience.current && <span class="current-label">現職</span>}
            </div>
            <h3>{experience.role}</h3>
            <p class="organization">{experience.organization}</p>
            {experience.location && <p>{experience.location}</p>}
            {experience.highlights.length > 0 && (
              <ul>
                {experience.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
  <StartingOut />
  <Speaking />
  <section class="education-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">FOUNDATIONS</p>
          <h2>學習，是持續發生的事。</h2>
        </div>
      </div>
      <div class="education-grid">
        <article class="credential">
          <span class="eyebrow">GOOGLE CLOUD CERTIFIED</span>
          <h3>
            Professional
            <br />
            Data Engineer
          </h3>
          <p>2026.01 核發 · 2028.01 到期</p>
        </article>
        <div class="education-list">
          <article>
            <span>2020 — 2022</span>
            <h3>國立成功大學</h3>
            <p>資訊管理碩士</p>
            <p class="education-note">
              碩士論文獲 Fubon Life Management Doctor and Master Thesis Award
              Honorable Mention，並入選 Chinese Institute of Industrial
              Engineers Conference。
            </p>
          </article>
          <article>
            <span>2016 — 2020</span>
            <h3>世新大學</h3>
            <p>資訊傳播學系學士</p>
          </article>
        </div>
      </div>
    </div>
  </section>
  <RelatedPages current="/work/" />
  <CoffeeChat
    title="從你正在處理的問題，開始聊。"
    text="職務合作、轉職探索，或 dbt、資料管線與雲端成本。選一個你最在意的題目就好。"
    prompts={conversationPrompts.work}
    label="複製 Email，開啟對話"
  />
</Base>

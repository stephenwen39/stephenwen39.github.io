---
import Base from '../layouts/Base.astro';
import CoffeeChat from '../components/CoffeeChat.astro';
import CopyEmail from '../components/CopyEmail.astro';
import RelatedPages from '../components/RelatedPages.astro';
import {
  profile,
  engineeringCases as cases,
  experiences,
} from '../data/content';
---

<Base
  title="資料工程與職涯 — Stephen Wen"
  description="Stephen Wen，TSMC Senior Data Engineer。探索 dbt、Databricks、GCP 與 Spark 的量化成果、工作經歷及 Taipei dbt Meetup 分享。"
  theme="work"
>
  <section class="work-hero">
    <div class="container">
      <a href="/" class="back-link">
        首頁 / 資料工程
      </a>
      <div class="work-hero-grid">
        <div>
          <p class="eyebrow">01 / DATA ENGINEERING</p>
          <h1>
            讓資料跑得更好，
            <br />
            也讓團隊走得更遠。
          </h1>
          <p class="detail-lead">
            我是 Stephen，現任 TSMC Senior Data Engineer。
            <br />從 0 到 1
            建立資料系統，也把既有架構做得更快、更省、更容易交付。
          </p>
          <div class="hero-buttons">
            <CopyEmail label="聊聊資料工程" variant="button-lime" />
            <a
              class="button button-on-dark"
              href={profile.socials[1].url}
              target="_blank"
              rel="noopener noreferrer"
            >
              查看 LinkedIn<span class="sr-only">（另開新分頁）</span>
            </a>
          </div>
        </div>
        <div class="engineering-note">
          <span class="eyebrow">WHAT I BUILD FOR</span>
          <div>
            <span>01</span>可擴充的架構
          </div>
          <div>
            <span>02</span>高效率的交付
          </div>
          <div>
            <span>03</span>可衡量的價值
          </div>
          <p>
            GCP · Databricks · dbt
            <br />
            BigQuery · Spark · Dataform
          </p>
        </div>
      </div>
    </div>
  </section>
  <section class="container section-space" aria-labelledby="impact-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">PROVEN IN PRACTICE</p>
        <h2 id="impact-title">讓成果，替實作說話。</h2>
      </div>
      <p class="section-aside">
        以下成果來自大聯大任職期間，
        <br />
        依公開 LinkedIn 資料整理。
      </p>
    </div>
    <div class="case-grid">
      {cases.map((c) => (
        <article class="case-card">
          <div class="case-number">{c.n}</div>
          <p class="case-metric">
            {c.value}
            <span>{c.unit}</span>
          </p>
          <p class="case-label">{c.label}</p>
          <span class="case-from">{c.from}</span>
          <h3>{c.title}</h3>
          <p class="case-description">{c.text}</p>
          <div class="tech-tags">
            {c.tags.map((t) => (
              <span>{t}</span>
            ))}
          </div>
          <details>
            <summary>
              看看做法與脈絡<span aria-hidden="true">＋</span>
            </summary>
            <p>{c.detail}</p>
          </details>
        </article>
      ))}
    </div>
  </section>
  <section class="experience-section">
    <div class="container split-section">
      <div class="section-intro">
        <p class="eyebrow">THE JOURNEY</p>
        <h2>
          一路累積的，
          <br />
          不只是工具。
        </h2>
        <p>
          從教育科技到企業資料平台，持續練習把技術限制、商業需求與人的工作方式放在一起思考。
        </p>
      </div>
      <div class="timeline">
        {experiences.map((experience) => (
          <article>
            <div class="timeline-meta">
              <span>{experience.period}</span>
              {experience.current && <span class="current-label">現職</span>}
            </div>
            <h3>{experience.role}</h3>
            <p class="organization">{experience.organization}</p>
            {experience.location && <p>{experience.location}</p>}
            {experience.highlights.length > 0 && (
              <ul>
                {experience.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="container section-space speaking-section">
    <div class="speaking-label">
      <span class="eyebrow">KNOWLEDGE, SHARED</span>
      <span class="serif-symbol" aria-hidden="true">
        “
      </span>
    </div>
    <div>
      <p class="event-label">Taipei dbt Meetup</p>
      <h2>
        把架構畫出來，
        <br />
        也把做決定的過程說清楚。
      </h2>
      <p>
        我曾在 Taipei dbt Meetup
        分享舊系統的架構解法與資料工程實作。技術分享讓我有機會，把工作裡的限制、取捨和經驗，轉成其他資料工作者能理解的內容。
      </p>
      <p>
        我也關心 Data
        Storytelling：當複雜資訊被說清楚，團隊才更容易對齊問題、一起採取行動。
      </p>
      <a
        class="text-link"
        href={profile.socials[1].url}
        target="_blank"
        rel="noopener noreferrer"
      >
        在 LinkedIn 看我的專業分享<span class="sr-only">（另開新分頁）</span>
      </a>
    </div>
  </section>
  <section class="education-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">FOUNDATIONS</p>
          <h2>學習，是持續發生的事。</h2>
        </div>
      </div>
      <div class="education-grid">
        <article class="credential">
          <span class="eyebrow">GOOGLE CLOUD CERTIFIED</span>
          <h3>
            Professional
            <br />
            Data Engineer
          </h3>
          <p>2026.01 核發 · 2028.01 到期</p>
        </article>
        <div class="education-list">
          <article>
            <span>2020 — 2022</span>
            <h3>國立成功大學</h3>
            <p>資訊管理碩士</p>
            <p class="education-note">
              碩士論文獲 Fubon Life Management Doctor and Master Thesis Award
              Honorable Mention，並入選 Chinese Institute of Industrial
              Engineers Conference。
            </p>
          </article>
          <article>
            <span>2016 — 2020</span>
            <h3>世新大學</h3>
            <p>資訊傳播學系學士</p>
          </article>
        </div>
      </div>
    </div>
  </section>
  <RelatedPages current="/work/" />
  <CoffeeChat
    title="你也在處理資料系統的難題嗎？"
    text="dbt 導入、Databricks、資料平台或雲端成本。歡迎帶著實際問題，一起交換做法。"
  />
</Base>

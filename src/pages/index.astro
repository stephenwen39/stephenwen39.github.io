---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CoffeeChat from '../components/CoffeeChat.astro';
import CopyEmail from '../components/CopyEmail.astro';
import CareerPath from '../components/CareerPath.astro';
import portrait from '../assets/stephen.jpg';
---

<Base>
  <section class="opening" aria-labelledby="home-title">
    <div class="container">
      <div class="intro-grid">
        <div class="intro-copy">
          <div class="intro-topline">
            <p class="eyebrow">嗨，我是展維</p>
            <p class="dual-role">
              資料工程師 <span aria-hidden="true">／</span> 自我成長教練
            </p>
          </div>
          <h1 id="home-title">
            做好資料工程，
            <br />
            也陪你找到方向。
          </h1>
          <p class="intro-description">
            現任台積電資深資料工程師，也投入學涯與職涯陪伴。
            <br class="desktop-break" />
            我擅長把複雜的問題理清，讓下一步更有方向。
          </p>
          <div class="action-row">
            <CopyEmail label="聊聊你的下一步" variant="button-lime" />
            <a class="light-link" href="/growth/">
              認識我的教練方式
            </a>
          </div>
          <p class="action-hint">點擊按鈕複製信箱，從你正在面對的問題聊起。</p>
        </div>
        <figure class="intro-portrait">
          <Image
            src={portrait}
            alt="展維 Stephen Wen 的個人照片"
            widths={[320, 640, 960]}
            sizes="(max-width: 800px) 76px, 280px"
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
          <figcaption>
            展維 <span>Stephen Wen</span>
          </figcaption>
        </figure>
      </div>
      <CareerPath />
    </div>
  </section>
  <section
    class="container focus-section"
    id="explore"
    aria-labelledby="focus-title"
  >
    <div class="section-intro">
      <p class="eyebrow">兩個方向，同樣投入</p>
      <h2 id="focus-title">把事情做好，也把人放在心上。</h2>
    </div>
    <div class="focus-pair">
      <a class="focus-panel engineering-panel" href="/work/">
        <span class="panel-number" aria-hidden="true">
          01
        </span>
        <p class="eyebrow">資料工程</p>
        <h3>
          讓技術解決
          <br />
          真正的商業問題。
        </h3>
        <p>
          遷移、從零建構、持續優化。把資料平台做得更快、更省，也更容易維護。
        </p>
        <div class="panel-proof">
          <strong>4 小時 → 10 分鐘</strong>
          <span>曾改善資料部署流程</span>
        </div>
        <span class="panel-link">看我的資料工程實績</span>
      </a>
      <a class="focus-panel coaching-panel" href="/growth/">
        <span class="panel-number" aria-hidden="true">
          02
        </span>
        <p class="eyebrow">自我成長教練</p>
        <h3>
          找到自己的理由，
          <br />
          走出自己的下一步。
        </h3>
        <p>
          從志工課輔到均一 DreamMore
          生涯陪伴，我陪你釐清選擇，長出屬於自己的自驅力。
        </p>
        <div class="panel-proof">
          <strong>學涯探索・職涯選擇・自驅力</strong>
          <span>從你的處境開始，一起思考</span>
        </div>
        <span class="panel-link">認識我的陪伴方式</span>
      </a>
    </div>
  </section>
  <CoffeeChat
    title="下一步還不清楚？一起聊聊。"
    text="學涯、職涯，或一個反覆困擾你的成長問題。先說說你在哪裡，我們再一起看向前方。"
    label="聊聊你的下一步"
  />
</Base>
